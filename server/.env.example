# Copy to .env and fill in. .env is gitignored — never commit real secrets.
PORT=8787
# X (Twitter) app-only Bearer token. Use VERBATIM as shown in the X dev portal
# (it contains literal %2B / %3D sequences — do NOT URL-decode it).
X_BEARER_TOKEN=PASTE_BEARER_VERBATIM
# Kick official API app credentials (https://kick.com/settings/developer). client_credentials, no user login.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Public origin of THIS backend (for the Kick chat webhook callback). On Railway, your app URL.
PUBLIC_BASE_URL=
# Optional: lock the control channel so only the creator can add/remove streams.
# If set, open the dashboard as  <frontend-url>/?key=<this-value>  to control streams.
# Leave blank for an open demo.
CONTROL_TOKEN=
